# ---------- Servidor ----------
PORT=3000
CORS_ORIGINS=http://localhost:9000,http://localhost:9200

# ---------- Base de datos ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transporte?schema=public"

# ---------- Redis (Memurai / Redis local / Redis Cloud) ----------
REDIS_URL="redis://localhost:6379"

# ---------- Auth ----------
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# ---------- Google Maps (Routes API) ----------
# Si se deja vacío se usa una estimación por línea recta (haversine)
GOOGLE_MAPS_API_KEY=""

# ---------- Reglas de negocio ----------
CURRENCY="USD"
SEARCH_RADIUS_KM=5
# minutos que un viaje puede quedar sin conductor antes de cancelarse
TRIP_REQUEST_TIMEOUT_MIN=3

# ---------- Seed (usuario administrador inicial) ----------
ADMIN_PHONE="70000000"
ADMIN_PASSWORD="admin123"
